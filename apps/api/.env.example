# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ── Datastores ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://medistock:medistock@localhost:5432/medistock?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-secret-change-me-please-32-chars-min
JWT_EXPIRES_IN=24h

# ── Reservation domain rules ───────────────────────────────────────────────
RESERVATION_TTL_MINUTES=30
MAX_HOLD_QUANTITY=5

# ── Geospatial search tuning ───────────────────────────────────────────────
GEO_DEFAULT_RADIUS_KM=5
GEO_MAX_RADIUS_KM=50
GEO_MAX_RESULTS=100

# ── Batch ingestion ───────────────────────────────────────────────────────
BATCH_SYNC_MAX_ITEMS=5000

# ── HTTP hardening ────────────────────────────────────────────────────────
RATE_LIMIT_MAX=200

# ── Background worker ─────────────────────────────────────────────────────
# When true the API process also runs the BullMQ expiry worker in-process.
# Keep false in production and run `npm run start:worker` as its own deployment.
RUN_WORKER_IN_PROCESS=false
EXPIRY_WORKER_CONCURRENCY=10
