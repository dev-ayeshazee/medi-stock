# Base URL for the MediStock API.
# Leave empty to use a same-origin relative path ("/api/v1/...") that is proxied
# by the Vite dev server (dev) or nginx (docker). Set an absolute URL only when
# the API is on a different origin and you rely on the API's CORS config.
VITE_API_BASE_URL=

# Dev-only: where `vite` proxies "/api" to.
VITE_API_PROXY=http://localhost:3000
